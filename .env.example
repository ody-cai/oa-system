# ===========================================
# OA 办公自动化系统 - 环境变量配置模板
# ===========================================
# 复制此文件为 .env.local 并填写实际值

# ===========================================
# Supabase 数据库配置
# ===========================================
# 从 Supabase 项目设置中获取：Project Settings > API
COZE_SUPABASE_URL=https://your-project-id.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# S3 兼容对象存储配置
# ===========================================
# 用于文件上传和存储
COZE_BUCKET_ENDPOINT_URL=https://your-bucket-endpoint.com
COZE_BUCKET_NAME=your-bucket-name

# ===========================================
# 应用配置
# ===========================================
# 运行端口（生产环境）
DEPLOY_RUN_PORT=5000

# 项目域名（用于生成访问链接）
COZE_PROJECT_DOMAIN_DEFAULT=your-domain.com

# ===========================================
# 可选配置
# ===========================================
# 开发/生产环境标识
# COZE_PROJECT_ENV=DEV | PROD

# ===========================================
# 安全提示
# ===========================================
# 1. 请勿将实际的 .env 文件提交到版本控制
# 2. 生产环境建议使用密钥管理服务
# 3. 定期轮换敏感凭证
